FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ARG JOBS=2
LABEL org.sonic-formal-infra.coverage="true"

RUN apt-get update && apt-get install -y \
    git autoconf automake libtool make \
    libreadline-dev texinfo pkg-config \
    libpam0g-dev libjson-c-dev bison flex \
    python3-pytest libc-ares-dev python3-dev \
    libsystemd-dev python3-sphinx \
    libelf-dev pcre2-utils libpcre2-dev \
    libprotobuf-c-dev protobuf-c-compiler \
    libcap-dev \
    build-essential curl cmake lcov procps

RUN git clone https://github.com/CESNET/libyang.git && \
    cd libyang && \
    git checkout v2.1.148 && \
    mkdir build && cd build && \
    cmake -DENABLE_LYD_PRIV=ON -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release .. && \
    make -j${JOBS} && \
    make install

RUN git clone -b frr-10.0.1 https://github.com/FRRouting/frr.git /frr
WORKDIR /frr

RUN ./bootstrap.sh
RUN ./configure \
    --enable-gcov \
    --localstatedir=/var/run/frr \
    --sbindir=/usr/lib/frr \
    --sysconfdir=/etc/frr \
    --enable-multipath=64 \
    --enable-user=frr \
    --enable-group=frr \
    --enable-vty-group=frrvty \
    --disable-ldpd \
    --disable-doc

RUN make -j${JOBS}
RUN make install
RUN ldconfig
ENV LD_LIBRARY_PATH=/usr/local/lib

RUN groupadd -r -g 92 frr
RUN groupadd -r -g 85 frrvty
RUN useradd -r -g 92 -u 92 -G frrvty frr
RUN mkdir -p /etc/frr /var/run/frr
RUN chown -R frr:frr /etc/frr /var/run/frr
RUN chmod 775 /var/run/frr
RUN chown frr:frrvty /etc/frr

# Change ownership of the build tree to frr user to allow writing .gcda files
RUN chown -R frr:frr /frr

COPY dummy_peer.py /usr/local/bin/bgpd-observer.py
# Keep the container available after bgpd exits so lcov can read flushed counters.
CMD ["bash", "-c", "python3 /usr/local/bin/bgpd-observer.py & /usr/lib/frr/bgpd -d -u frr -g frr -f /etc/frr/frr.conf && exec sleep infinity"]
