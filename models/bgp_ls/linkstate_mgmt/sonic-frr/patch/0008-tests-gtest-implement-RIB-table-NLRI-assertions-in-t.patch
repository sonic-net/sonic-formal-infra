+    bgp_ls_nlri* nlriCast = reinterpret_cast<bgp_ls_nlri*>(&p);
+    ASSERT_TRUE(bridge_link_exists_nlri(nlriCast))
+        << "[bgp_ls_nlri]: NLRI does not exist within the RIB.";
+  }
+}
